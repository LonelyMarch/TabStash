{
  "name": "tabstash",
  "version": "0.1.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wxt -b edge",
    "dev:edge": "wxt -b edge",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b edge",
    "build:chrome": "wxt build -b chrome",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:appearance": "playwright test tests/e2e/appearance.spec.ts",
    "capture:readme": "node scripts/capture-readme-screenshots.mjs",
    "install:chrome-test": "node scripts/install-chrome-for-testing.mjs",
    "check:package": "node scripts/check-package.mjs",
    "zip": "wxt zip -b edge",
    "zip:chrome": "wxt zip -b chrome",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tooltip": "1.2.16",
    "@webext-core/messaging": "4.0.0",
    "dexie": "4.4.6",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  },
  "packageManager": "pnpm@11.22.0"
}
